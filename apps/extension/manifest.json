{
  "manifest_version": 3,
  "name": "Sentinel Browser Companion",
  "version": "0.2.0",
  "description": "Local on-demand URL and message clues, with transparent coverage and no uploads.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinel Browser Companion"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fixture_block",
        "enabled": true,
        "path": "rules/fixture-block.json"
      }
    ]
  }
}
