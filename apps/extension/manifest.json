{
  "manifest_version": 3,
  "name": "Sentinel Browser Companion",
  "version": "0.2.0",
  "optional_permissions": ["scripting"],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "description": "Address-bar Link X-Ray, local scam-message checks and paired desktop demo tools.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinel Browser Companion"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fixture_block",
        "enabled": true,
        "path": "rules/fixture-block.json"
      }
    ]
  },
  "omnibox": {
    "keyword": "sentinel"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/whatsapp-inline.js", "src/message-detector.js", "src/message-feedback.js", "data/message-detector-config.js"],
      "matches": ["https://web.whatsapp.com/*"]
    },
    {
      "resources": [
        "warning.html",
        "src/xray.css",
        "src/warning.js",
        "src/navigation-policy.js",
        "src/local-checks.js",
        "data/badware-snapshot.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
