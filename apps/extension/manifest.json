{
  "manifest_version": 3,
  "name": "Sentinel Browser Companion",
  "version": "0.2.15",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "description": "Local link warnings and automatically connected Sentinel account tools.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {},
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fixture_block",
        "enabled": true,
        "path": "rules/fixture-block.json"
      }
    ]
  },
  "omnibox": {
    "keyword": "sentinel"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/whatsapp-inline.js",
        "src/message-detector.js",
        "data/message-detector-config.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    },
    {
      "resources": [
        "warning.html",
        "src/xray.css",
        "src/warning.js",
        "src/navigation-policy.js",
        "src/local-checks.js",
        "data/badware-snapshot.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "src/email/runtime.js",
        "src/email/extraction.js",
        "src/email/scoring.js",
        "src/email/technical.js",
        "src/email/banner.js",
        "src/email/providers/shared.js",
        "src/email/providers/gmail.js",
        "src/email/providers/outlook.js",
        "src/message-detector.js",
        "data/message-detector-config.js",
        "data/email-detector-config.js",
        "data/email-extraction-config.js",
        "src/email/link-guard.js",
        "src/assets/blue-investigate-v1.png",
        "src/assets/red-alert-v1.png",
        "src/assets/CabinetGrotesk-Variable.woff2"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ]
    },
    {
      "resources": [
        "src/assets/blue-ledge-v1.png",
        "src/assets/red-peeking-v1.png",
        "src/ui-overlay.css",
        "popup.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "key": ""
}
