{
  "manifest_version": 3,
  "name": "Sentinel Web Shield Harness",
  "version": "0.1.0",
  "description": "A narrow local fixture for testing the Sentinel Chrome extension boundary.",
  "permissions": ["declarativeNetRequest", "storage"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinel harness"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fixture_block",
        "enabled": true,
        "path": "rules/fixture-block.json"
      }
    ]
  }
}
